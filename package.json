{
  "name": "devwiz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev --turbopack\" \"pnpm run serwist:dev\"",
    "build": "pnpm run serwist:build && next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "format": "biome format --write .",
    "precommit": "lint-staged",
    "serwist:dev": "serwist build -c serwist.config.js --watch",
    "serwist:build": "serwist build -c serwist.config.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,css,md,yml,yaml}": [
      "biome check --write --diagnostic-level=error"
    ]
  },
